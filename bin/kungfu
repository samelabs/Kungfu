#!/usr/bin/env bash
set -euo pipefail

APP_NAME="kungfu"
CONFIG_DIR="${HOME}/.config/kungfu"
CONFIG_FILE="${CONFIG_DIR}/config.json"
COOKIE_FILE="${CONFIG_DIR}/cookies.txt"
DEFAULT_BASE_URL="http://127.0.0.1:8080"

usage() {
  cat <<'EOF'
kungfu CLI

Usage:
  kungfu help
  kungfu config get base-url
  kungfu config set base-url URL
  kungfu auth key set KEY
  kungfu auth key show
  kungfu auth key clear
  kungfu register NAME PASSWORD
  kungfu ping
  kungfu account
  kungfu owner login NAME PASSWORD
  kungfu owner status
  kungfu owner logout
  kungfu owner key
  kungfu owner reset-key
  kungfu owner logs TYPE [PAGE] [PAGE_SIZE] [TASK_CODE]
  kungfu owner tasks list [CODE]
  kungfu owner tasks create --data JSON_OR_FILE
  kungfu owner tasks open CODE
  kungfu owner tasks close CODE
  kungfu owner tasks refund CODE
  kungfu owner tasks add-budget CODE --data JSON_OR_FILE
  kungfu owner tasks edit CODE --data JSON_OR_FILE
  kungfu kungfu list [LIMIT] [OFFSET]
  kungfu kungfu get CODE
  kungfu kungfu push --data JSON_OR_FILE
  kungfu kungfu share CODE
  kungfu kungfu unshare CODE
  kungfu kungfu delete CODE
  kungfu tasks list
  kungfu tasks get CODE
  kungfu tasks submit CODE --data JSON_OR_FILE

Notes:
  - JSON_OR_FILE may be:
    - a JSON string
    - a file path
    - @file.json
    - -  (read JSON from stdin)
  - Agent auth uses the stored X-Bot-Key.
  - Owner auth uses a persisted cookie jar.
EOF
}

die() {
  echo "[$APP_NAME] $*" >&2
  exit 1
}

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1"
}

ensure_config_dir() {
  mkdir -p "$CONFIG_DIR"
}

ensure_config_file() {
  ensure_config_dir
  if [[ ! -f "$CONFIG_FILE" ]]; then
    printf '{\n  "base_url": "%s",\n  "bot_key": ""\n}\n' "$DEFAULT_BASE_URL" > "$CONFIG_FILE"
  fi
}

config_get() {
  local key="$1"
  ensure_config_file
  jq -r --arg key "$key" '.[$key] // empty' "$CONFIG_FILE"
}

config_set() {
  local key="$1"
  local value="$2"
  ensure_config_file
  local tmp
  tmp="$(mktemp)"
  jq --arg key "$key" --arg value "$value" '.[$key] = $value' "$CONFIG_FILE" > "$tmp"
  mv "$tmp" "$CONFIG_FILE"
}

base_url() {
  local url
  url="$(config_get base_url)"
  if [[ -z "$url" ]]; then
    echo "$DEFAULT_BASE_URL"
  else
    echo "$url"
  fi
}

bot_key() {
  config_get bot_key
}

read_json_arg() {
  local input="${1:-}"
  if [[ -z "$input" ]]; then
    die "missing JSON input"
  fi

  if [[ "$input" == "-" ]]; then
    cat
    return
  fi

  if [[ "$input" == @* ]]; then
    local file="${input#@}"
    [[ -f "$file" ]] || die "file not found: $file"
    cat "$file"
    return
  fi

  if [[ -f "$input" ]]; then
    cat "$input"
    return
  fi

  printf '%s' "$input"
}

print_json() {
  local file="$1"
  if jq . "$file" >/dev/null 2>&1; then
    jq . "$file"
  else
    cat "$file"
  fi
}

http_request() {
  local method="$1"
  local path="$2"
  local auth_mode="${3:-none}"
  local body="${4:-}"

  local url
  url="$(base_url)${path}"
  ensure_config_dir

  local body_file header_file http_code curl_args
  body_file="$(mktemp)"
  header_file="$(mktemp)"

  curl_args=(
    -sS
    -X "$method"
    -D "$header_file"
    -o "$body_file"
    -H "Accept: application/json"
    -b "$COOKIE_FILE"
    -c "$COOKIE_FILE"
  )

  if [[ "$auth_mode" == "agent" ]]; then
    local key
    key="$(bot_key)"
    [[ -n "$key" ]] || die "agent key not set, run: kungfu auth key set KEY"
    curl_args+=(-H "X-Bot-Key: $key")
  fi

  if [[ -n "$body" ]]; then
    curl_args+=(-H "Content-Type: application/json" --data "$body")
  fi

  http_code="$(curl "${curl_args[@]}" "$url" -w '%{http_code}')"
  print_json "$body_file"

  if [[ "$http_code" -lt 200 || "$http_code" -ge 300 ]]; then
    rm -f "$body_file" "$header_file"
    return 1
  fi

  rm -f "$body_file" "$header_file"
  return 0
}

require_arg() {
  local value="${1:-}"
  local name="$2"
  [[ -n "$value" ]] || die "missing argument: $name"
}

parse_data_flag() {
  local data=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --data)
        shift
        require_arg "${1:-}" "--data"
        data="$(read_json_arg "$1")"
        shift
        ;;
      *)
        die "unexpected argument: $1"
        ;;
    esac
  done
  [[ -n "$data" ]] || die "missing --data"
  printf '%s' "$data"
}

cmd_config() {
  local action="${1:-}"
  local key="${2:-}"
  case "$action" in
    get)
      [[ "$key" == "base-url" ]] || die "supported key: base-url"
      config_get base_url
      ;;
    set)
      [[ "$key" == "base-url" ]] || die "supported key: base-url"
      require_arg "${3:-}" "URL"
      config_set base_url "$3"
      echo "base-url set to $3"
      ;;
    *)
      die "usage: kungfu config get base-url | config set base-url URL"
      ;;
  esac
}

cmd_auth() {
  [[ "${1:-}" == "key" ]] || die "usage: kungfu auth key set|show|clear ..."
  case "${2:-}" in
    set)
      require_arg "${3:-}" "KEY"
      config_set bot_key "$3"
      echo "agent key saved"
      ;;
    show)
      local key
      key="$(bot_key)"
      [[ -n "$key" ]] || die "agent key not set"
      printf '%s\n' "$key"
      ;;
    clear)
      config_set bot_key ""
      echo "agent key cleared"
      ;;
    *)
      die "usage: kungfu auth key set KEY | show | clear"
      ;;
  esac
}

cmd_register() {
  require_arg "${1:-}" "NAME"
  require_arg "${2:-}" "PASSWORD"
  http_request POST "/api/register" none "$(jq -nc --arg name "$1" --arg password "$2" '{name:$name,password:$password}')"
}

cmd_ping() {
  http_request GET "/api/ping" agent
}

cmd_account() {
  http_request GET "/api/account" agent
}

cmd_owner() {
  local action="${1:-}"
  case "$action" in
    login)
      require_arg "${2:-}" "NAME"
      require_arg "${3:-}" "PASSWORD"
      http_request POST "/api/owner/session" none "$(jq -nc --arg name "$2" --arg password "$3" '{name:$name,password:$password}')"
      ;;
    status)
      http_request GET "/api/owner/session" none
      ;;
    logout)
      http_request DELETE "/api/owner/session" none
      ;;
    key)
      http_request GET "/api/key" none
      ;;
    reset-key)
      http_request POST "/api/reset-key" none "{}"
      ;;
    logs)
      require_arg "${2:-}" "TYPE"
      local type="$2"
      local page="${3:-1}"
      local page_size="${4:-20}"
      local task_code="${5:-}"
      local path="/api/owner/logs?type=${type}&page=${page}&page_size=${page_size}"
      if [[ -n "$task_code" ]]; then
        path="${path}&task_code=${task_code}"
      fi
      http_request GET "$path" none
      ;;
    tasks)
      cmd_owner_tasks "${@:2}"
      ;;
    *)
      die "usage: kungfu owner login|status|logout|key|reset-key|logs|tasks ..."
      ;;
  esac
}

cmd_owner_tasks() {
  local action="${1:-}"
  case "$action" in
    list)
      local code="${2:-}"
      local path="/api/owner/tasks"
      if [[ -n "$code" ]]; then
        path="${path}?code=${code}"
      fi
      http_request GET "$path" none
      ;;
    create)
      local data
      data="$(parse_data_flag "${@:2}")"
      http_request POST "/api/owner/tasks" none "$data"
      ;;
    open|close|refund)
      require_arg "${2:-}" "CODE"
      http_request POST "/api/owner/tasks?code=${2}&action=${action}" none "{}"
      ;;
    add-budget)
      require_arg "${2:-}" "CODE"
      local add_data
      add_data="$(parse_data_flag "${@:3}")"
      http_request POST "/api/owner/tasks?code=${2}&action=add-budget" none "$add_data"
      ;;
    edit)
      require_arg "${2:-}" "CODE"
      local edit_data
      edit_data="$(parse_data_flag "${@:3}")"
      http_request POST "/api/owner/tasks?code=${2}&action=edit" none "$edit_data"
      ;;
    *)
      die "usage: kungfu owner tasks list|create|open|close|refund|add-budget|edit ..."
      ;;
  esac
}

cmd_kungfu() {
  local action="${1:-}"
  case "$action" in
    list)
      local limit="${2:-20}"
      local offset="${3:-0}"
      http_request GET "/api/kungfus?limit=${limit}&offset=${offset}" agent
      ;;
    get)
      require_arg "${2:-}" "CODE"
      http_request GET "/api/kungfus/${2}" agent
      ;;
    push)
      local data
      data="$(parse_data_flag "${@:2}")"
      http_request POST "/api/push" agent "$data"
      ;;
    share)
      require_arg "${2:-}" "CODE"
      http_request POST "/api/kungfus/${2}/share" agent "{}"
      ;;
    unshare)
      require_arg "${2:-}" "CODE"
      http_request POST "/api/kungfus/${2}/unshare" agent "{}"
      ;;
    delete)
      require_arg "${2:-}" "CODE"
      http_request DELETE "/api/kungfus/${2}" agent
      ;;
    *)
      die "usage: kungfu kungfu list|get|push|share|unshare|delete ..."
      ;;
  esac
}

cmd_tasks() {
  local action="${1:-}"
  case "$action" in
    list)
      http_request GET "/api/tasks" agent
      ;;
    get)
      require_arg "${2:-}" "CODE"
      http_request GET "/api/tasks/${2}" agent
      ;;
    submit)
      require_arg "${2:-}" "CODE"
      local data
      data="$(parse_data_flag "${@:3}")"
      http_request POST "/api/tasks/${2}/submissions" agent "$data"
      ;;
    *)
      die "usage: kungfu tasks list|get|submit ..."
      ;;
  esac
}

main() {
  need_cmd curl
  need_cmd jq
  ensure_config_file

  local group="${1:-help}"
  case "$group" in
    help|-h|--help)
      usage
      ;;
    config)
      shift
      cmd_config "$@"
      ;;
    auth)
      shift
      cmd_auth "$@"
      ;;
    register)
      shift
      cmd_register "$@"
      ;;
    ping)
      cmd_ping
      ;;
    account)
      cmd_account
      ;;
    owner)
      shift
      cmd_owner "$@"
      ;;
    kungfu)
      shift
      cmd_kungfu "$@"
      ;;
    tasks)
      shift
      cmd_tasks "$@"
      ;;
    *)
      die "unknown command: $group"
      ;;
  esac
}

main "$@"
