{
  "listen": ":8080",
  "criteria": [
    {
      "id": "C1",
      "required": ["/url", "/bullets"]
    },
    {
      "id": "C2",
      "pattern": { "pointer": "/url", "regex": "^https://[^\\s]+$" }
    },
    {
      "id": "C3",
      "schema": {
        "type": "object",
        "properties": {
          "url": { "type": "string" },
          "bullets": { "type": "array", "items": { "type": "string" }, "minItems": 3, "maxItems": 3 }
        },
        "required": ["url", "bullets"],
        "additionalProperties": false
      }
    }
  ]
}
